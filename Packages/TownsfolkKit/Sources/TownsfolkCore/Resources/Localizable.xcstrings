{
  "sourceLanguage" : "en",
  "strings" : {
    "availability.appleIntelligenceOff.message" : {
      "comment" : "Model unavailable: Apple Intelligence is turned off. \"Apple Intelligence & Siri\" is the name of the System Settings pane and must match the system's own.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Townsfolk needs Apple Intelligence to write the town. Turn it on in System Settings › Apple Intelligence & Siri."
          }
        }
      }
    },
    "availability.deviceNotEligible.message" : {
      "comment" : "Model unavailable: this Mac cannot run Apple Intelligence at all.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac can't run Apple Intelligence, which Townsfolk needs."
          }
        }
      }
    },
    "availability.modelNotReady.message" : {
      "comment" : "Model unavailable: Apple Intelligence is on but its model is not downloaded yet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The on-device model is still downloading. The town starts when it's ready."
          }
        }
      }
    },
    "availability.openSystemSettings" : {
      "comment" : "Model unavailable: the button that opens the System Settings app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open System Settings"
          }
        }
      }
    },
    "composer.counter.left" : {
      "comment" : "Composer: under the field once 20 or fewer characters remain before the limit. The argument is how many characters may still be typed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld left"
          }
        }
      }
    },
    "composer.counter.over" : {
      "comment" : "Composer: under the field, after a warning symbol, when the text is longer than a post may be; Return then does nothing. The argument is how many characters too many there are.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld over"
          }
        }
      }
    },
    "composer.placeholder" : {
      "comment" : "Composer: the placeholder of the one-line field where you post to the town. The argument is the town's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say something to %@…"
          }
        }
      }
    },
    "composer.reply.cancel" : {
      "comment" : "Composer: the label of the ✕ button on the replying chip, read by VoiceOver and shown as a tooltip. It leaves reply mode and keeps what you typed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel Reply"
          }
        }
      }
    },
    "composer.reply.chip" : {
      "comment" : "Composer: the chip above the field while you reply, after a reply symbol. The arguments are the name of the post's author and its text, which is cut short to one line.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replying to %@ \"%@\""
          }
        }
      }
    },
    "composer.reply.reading" : {
      "comment" : "VoiceOver: the composer's chip while you reply. The arguments are the name of the post's author and its text.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replying to %@: %@"
          }
        }
      }
    },
    "firstRun.continue" : {
      "comment" : "First run: the default button that keeps the typed name and founds the town.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        }
      }
    },
    "firstRun.founding.announcement.movedTo" : {
      "comment" : "Founding: VoiceOver announcement once the person's town is founded. The argument is the town's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You moved to %@."
          }
        }
      }
    },
    "firstRun.founding.failed" : {
      "comment" : "Founding: shown in place of the steps when founding failed after every retry.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't find you a town this time."
          }
        }
      }
    },
    "firstRun.founding.heading" : {
      "comment" : "Founding: the heading while the person's town is being made, step by step.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding you a town…"
          }
        }
      }
    },
    "firstRun.founding.slow" : {
      "comment" : "Founding: added under the steps once founding has run for a minute.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is taking longer than usual."
          }
        }
      }
    },
    "firstRun.founding.step.done" : {
      "comment" : "Founding: VoiceOver label of a step's check mark, once the step is finished.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done"
          }
        }
      }
    },
    "firstRun.founding.step.firstScene" : {
      "comment" : "Founding: the third step's line, checked once the residents' first posts exist.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saying hello"
          }
        }
      }
    },
    "firstRun.founding.step.pending" : {
      "comment" : "Founding: VoiceOver label of a step's dotted circle, while the step is not finished.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not yet"
          }
        }
      }
    },
    "firstRun.founding.step.residents" : {
      "comment" : "Founding: the second step's line, checked once the first residents exist.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeting the neighbors"
          }
        }
      }
    },
    "firstRun.founding.step.town" : {
      "comment" : "Founding: the first step's line, checked once the town itself exists.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drawing the streets"
          }
        }
      }
    },
    "firstRun.founding.tryAgain" : {
      "comment" : "Founding: the default button that starts founding again after it failed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try Again"
          }
        }
      }
    },
    "firstRun.machineryNote" : {
      "comment" : "First run: the one line that says the town's people are written by Apple's on-device language model, which runs on this Mac only.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its residents are written by Apple's on-device model, right on this Mac."
          }
        }
      }
    },
    "firstRun.name.help" : {
      "comment" : "First run: helper text under the name field.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Residents see this name on your posts."
          }
        }
      }
    },
    "firstRun.name.over" : {
      "comment" : "First run: shown under the name field while the name is too long. The argument is how many characters over the limit it is.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld over"
          }
        }
      }
    },
    "firstRun.name.prompt" : {
      "comment" : "First run: the question above the name field, also the field's label.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What should the town call you?"
          }
        }
      }
    },
    "firstRun.welcome" : {
      "comment" : "First run: the heading of the screen that asks for the person's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small town is waiting for you."
          }
        }
      }
    },
    "founding.event.movedTo" : {
      "comment" : "Timeline: the first row of every town, stored when it is founded. The argument is the town's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You moved to %@."
          }
        }
      }
    },
    "settings.keepsMoving.help" : {
      "comment" : "Settings: helper text under the keep-moving toggle. \"Rests\" means the town pauses.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the town rests unless its window is active."
          }
        }
      }
    },
    "settings.keepsMoving.title" : {
      "comment" : "Settings: the label of the toggle that lets the town keep running while another app is in front, as long as its window is visible.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the town moving while I use other apps"
          }
        }
      }
    },
    "settings.name.error" : {
      "comment" : "Settings: shown under the name field when the submitted name is empty or too long. The arguments are the fewest and the most characters a name may have.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use %lld–%lld characters."
          }
        }
      }
    },
    "settings.name.title" : {
      "comment" : "Settings: the label of the field holding the person's own name in the town.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your name"
          }
        }
      }
    },
    "settings.speed.fast" : {
      "comment" : "Settings: the fastest speed, a segment of the speed control.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast"
          }
        }
      }
    },
    "settings.speed.hint.fast" : {
      "comment" : "Settings: helper under the speed control while Fast is chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About one new post every 30 seconds."
          }
        }
      }
    },
    "settings.speed.hint.normal" : {
      "comment" : "Settings: helper under the speed control while Normal is chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About one new post every 3 minutes."
          }
        }
      }
    },
    "settings.speed.hint.slow" : {
      "comment" : "Settings: helper under the speed control while Slow is chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About one new post every 15 minutes."
          }
        }
      }
    },
    "settings.speed.normal" : {
      "comment" : "Settings: the default speed, a segment of the speed control.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal"
          }
        }
      }
    },
    "settings.speed.slow" : {
      "comment" : "Settings: the slowest speed, a segment of the speed control.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow"
          }
        }
      }
    },
    "settings.speed.title" : {
      "comment" : "Settings: the label of the segmented control choosing how often the town posts.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed"
          }
        }
      }
    },
    "statusLine.accessibilityLabel" : {
      "comment" : "Status line: what VoiceOver calls the one line at the top of the town window.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Town status"
          }
        }
      }
    },
    "statusLine.event" : {
      "comment" : "Status line: the one line at the top of the town window while an event is going on and the town has no recent topic. The argument is the event's one-line description.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "statusLine.eventAndTopic" : {
      "comment" : "Status line: the one line at the top of the town window while an event is going on and the town has a recent topic. The first argument is the event's one-line description, the second the topic.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@"
          }
        }
      }
    },
    "statusLine.quiet" : {
      "comment" : "Status line: the one line at the top of the town window when no event is going on and nobody posted about anything recently. The argument is the town's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiet day in %@"
          }
        }
      }
    },
    "statusLine.topic" : {
      "comment" : "Status line: the one line at the top of the town window when no event is going on. The argument is what the residents posted about most recently.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone's talking about %@"
          }
        }
      }
    },
    "timeline.announcement.repliedToYou" : {
      "comment" : "VoiceOver announcement when a resident's post replying to one of yours appears. The argument is the resident's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ replied to you"
          }
        }
      }
    },
    "timeline.event.reading" : {
      "comment" : "VoiceOver: something that happened in town. The arguments are the event's one-line text and its relative time (\"now\", \"5m\").",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@"
          }
        }
      }
    },
    "timeline.group.reading" : {
      "comment" : "VoiceOver: a conversation of one or more posts. The argument is how many posts it holds.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Conversation, %lld post"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Conversation, %lld posts"
                }
              }
            }
          }
        }
      }
    },
    "timeline.newPosts" : {
      "comment" : "Timeline: the button above the posts, after an up-arrow symbol, counting the posts that arrived while you were reading older ones. Clicking it scrolls to the newest. The argument is how many arrived.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld new post"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld new posts"
                }
              }
            }
          }
        }
      }
    },
    "timeline.post.reading" : {
      "comment" : "VoiceOver: a resident's post. The arguments are the resident's name, the relative time (\"now\", \"5m\"), and the post's text.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@: %@"
          }
        }
      }
    },
    "timeline.post.replyButton" : {
      "comment" : "Timeline: the label of the reply-symbol button that appears at the end of a post's header on hover, read by VoiceOver and shown as a tooltip.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reply"
          }
        }
      }
    },
    "timeline.post.you" : {
      "comment" : "Timeline: the name on your own posts and quotes of them when no name is stored.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You"
          }
        }
      }
    },
    "timeline.post.youMarker" : {
      "comment" : "Timeline: shown after your own name on your posts, in a lighter color, so they are told apart from the residents'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(you)"
          }
        }
      }
    },
    "timeline.post.yourReading" : {
      "comment" : "VoiceOver: one of your own posts. The arguments are the relative time (\"now\", \"5m\") and the post's text.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You, %@: %@"
          }
        }
      }
    },
    "timeline.quote.line" : {
      "comment" : "Timeline: the one-line quote of the older post a conversation replies to, after a reply symbol. The arguments are its author's name and its text, which is cut short to one line.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: \"%@\""
          }
        }
      }
    },
    "timeline.quote.reading" : {
      "comment" : "VoiceOver: the quote of the older post a conversation replies to. The arguments are its author's name and its text.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replying to %@: %@"
          }
        }
      }
    },
    "timeline.time.now" : {
      "comment" : "Timeline: the relative time of a post or event less than a minute old, after the name (\"Jun · now\").",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "now"
          }
        }
      }
    },
    "town.menu.newPost" : {
      "comment" : "Menu bar: the Town menu command (⌘N) that puts the cursor in the composer to write a new post, leaving any reply.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New Post"
          }
        }
      }
    },
    "town.menu.reply" : {
      "comment" : "Menu bar: the Town menu command (⌘R) that replies to the selected post.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reply"
          }
        }
      }
    },
    "town.menu.scrollToLatest" : {
      "comment" : "Menu bar: the Town menu command (⌘↑) that scrolls the timeline to its newest posts.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll to Latest"
          }
        }
      }
    },
    "town.menu.title" : {
      "comment" : "Menu bar: the title of the Town menu, which holds the timeline's commands.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Town"
          }
        }
      }
    }
  },
  "version" : "1.0"
}