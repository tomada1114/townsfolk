{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.keepsMoving.help" : {
      "comment" : "Settings: helper text under the keep-moving toggle. \"Rests\" means the town pauses.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the town rests unless its window is active."
          }
        }
      }
    },
    "settings.keepsMoving.title" : {
      "comment" : "Settings: the label of the toggle that lets the town keep running while another app is in front, as long as its window is visible.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the town moving while I use other apps"
          }
        }
      }
    },
    "settings.name.error" : {
      "comment" : "Settings: shown under the name field when the submitted name is empty or too long. The arguments are the fewest and the most characters a name may have.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use %lld–%lld characters."
          }
        }
      }
    },
    "settings.name.title" : {
      "comment" : "Settings: the label of the field holding the person's own name in the town.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your name"
          }
        }
      }
    },
    "settings.speed.fast" : {
      "comment" : "Settings: the fastest speed, a segment of the speed control.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast"
          }
        }
      }
    },
    "settings.speed.hint.fast" : {
      "comment" : "Settings: helper under the speed control while Fast is chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About one new post every 30 seconds."
          }
        }
      }
    },
    "settings.speed.hint.normal" : {
      "comment" : "Settings: helper under the speed control while Normal is chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About one new post every 3 minutes."
          }
        }
      }
    },
    "settings.speed.hint.slow" : {
      "comment" : "Settings: helper under the speed control while Slow is chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About one new post every 15 minutes."
          }
        }
      }
    },
    "settings.speed.normal" : {
      "comment" : "Settings: the default speed, a segment of the speed control.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal"
          }
        }
      }
    },
    "settings.speed.slow" : {
      "comment" : "Settings: the slowest speed, a segment of the speed control.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow"
          }
        }
      }
    },
    "settings.speed.title" : {
      "comment" : "Settings: the label of the segmented control choosing how often the town posts.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed"
          }
        }
      }
    },
    "timeline.announcement.repliedToYou" : {
      "comment" : "VoiceOver announcement when a resident's post replying to one of yours appears. The argument is the resident's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ replied to you"
          }
        }
      }
    },
    "timeline.event.reading" : {
      "comment" : "VoiceOver: something that happened in town. The arguments are the event's one-line text and its relative time (\"now\", \"5m\").",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@"
          }
        }
      }
    },
    "timeline.group.reading" : {
      "comment" : "VoiceOver: a conversation of one or more posts. The argument is how many posts it holds.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Conversation, %lld post"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Conversation, %lld posts"
                }
              }
            }
          }
        }
      }
    },
    "timeline.newPosts" : {
      "comment" : "Timeline: the button above the posts, after an up-arrow symbol, counting the posts that arrived while you were reading older ones. Clicking it scrolls to the newest. The argument is how many arrived.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld new post"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld new posts"
                }
              }
            }
          }
        }
      }
    },
    "timeline.post.reading" : {
      "comment" : "VoiceOver: a resident's post. The arguments are the resident's name, the relative time (\"now\", \"5m\"), and the post's text.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@: %@"
          }
        }
      }
    },
    "timeline.post.you" : {
      "comment" : "Timeline: the name on your own posts and quotes of them when no name is stored.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You"
          }
        }
      }
    },
    "timeline.post.youMarker" : {
      "comment" : "Timeline: shown after your own name on your posts, in a lighter color, so they are told apart from the residents'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(you)"
          }
        }
      }
    },
    "timeline.post.yourReading" : {
      "comment" : "VoiceOver: one of your own posts. The arguments are the relative time (\"now\", \"5m\") and the post's text.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You, %@: %@"
          }
        }
      }
    },
    "timeline.quote.line" : {
      "comment" : "Timeline: the one-line quote of the older post a conversation replies to, after a reply symbol. The arguments are its author's name and its text, which is cut short to one line.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: \"%@\""
          }
        }
      }
    },
    "timeline.quote.reading" : {
      "comment" : "VoiceOver: the quote of the older post a conversation replies to. The arguments are its author's name and its text.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replying to %@: %@"
          }
        }
      }
    },
    "timeline.time.now" : {
      "comment" : "Timeline: the relative time of a post or event less than a minute old, after the name (\"Jun · now\").",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "now"
          }
        }
      }
    },
    "town.menu.scrollToLatest" : {
      "comment" : "Menu bar: the Town menu command (⌘↑) that scrolls the timeline to its newest posts.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll to Latest"
          }
        }
      }
    },
    "town.menu.title" : {
      "comment" : "Menu bar: the title of the Town menu, which holds the timeline's commands.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Town"
          }
        }
      }
    }
  },
  "version" : "1.0"
}