{
  "sourceLanguage" : "en",
  "strings" : {
    "availability.appleIntelligenceOff.message" : {
      "comment" : "Model unavailable: Apple Intelligence is turned off. \"Apple Intelligence & Siri\" is the name of the System Settings pane and must match the system's own.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Townsfolk needs Apple Intelligence to write the town. Turn it on in System Settings › Apple Intelligence & Siri."
          }
        }
      }
    },
    "availability.deviceNotEligible.message" : {
      "comment" : "Model unavailable: this Mac cannot run Apple Intelligence at all.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac can't run Apple Intelligence, which Townsfolk needs."
          }
        }
      }
    },
    "availability.modelNotReady.message" : {
      "comment" : "Model unavailable: Apple Intelligence is on but its model is not downloaded yet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The on-device model is still downloading. The town starts when it's ready."
          }
        }
      }
    },
    "availability.openSystemSettings" : {
      "comment" : "Model unavailable: the button that opens the System Settings app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open System Settings"
          }
        }
      }
    },
    "settings.keepsMoving.help" : {
      "comment" : "Settings: helper text under the keep-moving toggle. \"Rests\" means the town pauses.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the town rests unless its window is active."
          }
        }
      }
    },
    "settings.keepsMoving.title" : {
      "comment" : "Settings: the label of the toggle that lets the town keep running while another app is in front, as long as its window is visible.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the town moving while I use other apps"
          }
        }
      }
    },
    "settings.name.error" : {
      "comment" : "Settings: shown under the name field when the submitted name is empty or too long. The arguments are the fewest and the most characters a name may have.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use %lld–%lld characters."
          }
        }
      }
    },
    "settings.name.title" : {
      "comment" : "Settings: the label of the field holding the person's own name in the town.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your name"
          }
        }
      }
    },
    "settings.speed.fast" : {
      "comment" : "Settings: the fastest speed, a segment of the speed control.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast"
          }
        }
      }
    },
    "settings.speed.hint.fast" : {
      "comment" : "Settings: helper under the speed control while Fast is chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About one new post every 30 seconds."
          }
        }
      }
    },
    "settings.speed.hint.normal" : {
      "comment" : "Settings: helper under the speed control while Normal is chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About one new post every 3 minutes."
          }
        }
      }
    },
    "settings.speed.hint.slow" : {
      "comment" : "Settings: helper under the speed control while Slow is chosen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About one new post every 15 minutes."
          }
        }
      }
    },
    "settings.speed.normal" : {
      "comment" : "Settings: the default speed, a segment of the speed control.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal"
          }
        }
      }
    },
    "settings.speed.slow" : {
      "comment" : "Settings: the slowest speed, a segment of the speed control.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow"
          }
        }
      }
    },
    "settings.speed.title" : {
      "comment" : "Settings: the label of the segmented control choosing how often the town posts.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed"
          }
        }
      }
    }
  },
  "version" : "1.0"
}